// Bodlogo 11
int sum_to(int n) {
    int sum = 0;
    for (int i = 1; i <= n; i++) {
        sum += i;
    }
    return sum;
}

// Bodlogo 12
long long factorial(int n) {
    long long result = 1;
    for (int i = 1; i <= n; i++) {
        result *= i;
    }
    return result;
}

// Bodlogo 13
int is_prime(int n) {
    if (n < 2)
        return 0;
    for (int i = 2; i <= n / i; i++) {
        if (n % i == 0)
            return 0;
    }
    return 1;
}

// Bodlogo 14
int count_digits(int n) {
    int count = 0;
    do {
        count++;
        n /= 10;
    } while (n != 0);
    return count;
}

// Bodlogo 15
int digit_sum(int n) {
    int sum = 0;
    while (n > 0) {
        sum += n % 10;
        n /= 10;
    }
    return sum;
}

// Bodlogo 16
int reverse_number(int n) {
    int reversed = 0;
    while (n > 0) {
        reversed = reversed * 10 + n % 10;
        n /= 10;
    }
    return reversed;
}

// Bodlogo 17
int is_palindrome(int n) {
    int original = n;
    int reversed = 0;

    while (n > 0) {
        reversed = reversed * 10 + n % 10;
        n /= 10;
    }

    if (original == reversed)
        return 1;
    else
        return 0;
}

// Bodlogo 18
int gcd(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

// Bodlogo 19
// gcd функц дээр тодорхойлогдсон.
long long lcm(int a, int b) {
    return (long long)(a / gcd(a, b)) * b;
}

// Bodlogo 20
long long power(int base, int exp) {
    long long result = 1;
    for (int i = 0; i < exp; i++) {
        result *= base;
    }
    return result;
}

// Bodlogo 21
int is_leap(int y) {
    if (y % 400 == 0 || (y % 4 == 0 && y % 100 != 0))
        return 1;
    else
        return 0;
}

// Bodlogo 22
// is_leap функц дээр тодорхойлогдсон.
int days_in_month(int m, int y) {
    if (m == 2) {
        if (is_leap(y))
            return 29;
        else
            return 28;
    }
    if (m == 4 || m == 6 || m == 9 || m == 11)
        return 30;
    else
        return 31;
}

// Bodlogo 23
int count_divisors(int n) {
    int count = 0;
    for (int i = 1; i <= n / i; i++) {
        if (n % i == 0) {
            if (i == n / i)
                count++;
            else
                count += 2;
        }
    }
    return count;
}

// Bodlogo 24
int is_perfect(int n) {
    int sum = 1;
    for (int i = 2; i <= n / i; i++) {
        if (n % i == 0) {
            sum += i;
            if (i != n / i)
                sum += n / i;
        }
    }
    return sum == n ? 1 : 0;
}

