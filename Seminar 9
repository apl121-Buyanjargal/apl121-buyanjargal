// Bodlogo 1
int square(int x) {
    return x * x;
}

// Bodlogo 2
int max2(int a, int b) {
    if (a > b)
        return a;
    else
        return b;
}

// Bodlogo 3
int max3(int a, int b, int c) {
    int max = a;
    if (b > max)
        max = b;
    if (c > max)
        max = c;
    return max;
}

// Bodlogo 4
int is_even(int n) {
    if (n % 2 == 0)
        return 1;
    else
        return 0;
}

// Bodlogo 5
int absolute(int x) {
    if (x < 0)
        return -x;
    else
        return x;
}

// Bodlogo 6
double circle_area(double r) {
    return 3.14159265358979 * r * r;
}

// Bodlogo 7
void print_line(int n, char c) {
    for (int i = 0; i < n; i++) {
        printf("%c", c);
    }
    printf("\n");
}

// Bodlogo 8
int sign(int x) {
    if (x > 0)
        return 1;
    else if (x < 0)
        return -1;
    else
        return 0;
}

// Bodlogo 9
double avg3(int a, int b, int c) {
    return (a + b + c) / 3.0;
}

// Bodlogo 10
int last_digit(int n) {
    int digit = n % 10;
    if (digit < 0)
        digit = -digit;
    return digit;
}
